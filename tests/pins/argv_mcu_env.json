{
 "args": [
  "codex",
  "exec",
  "--json",
  "--skip-git-repo-check",
  "--ignore-user-config",
  "--ignore-rules",
  "-m",
  "qwen",
  "-c",
  "model_reasoning_effort=\"low\"",
  "-o",
  "<tmp>/ws/last_message.txt",
  "-c",
  "model_max_output_tokens=1024",
  "-c",
  "model_provider=local",
  "-c",
  "model_providers.local.name=\"local\"",
  "-c",
  "model_providers.local.base_url=\"http://127.0.0.1:8000/v1\"",
  "-c",
  "model_providers.local.wire_api=\"responses\"",
  "-c",
  "model_providers.local.env_key=\"LOCAL_API_KEY\"",
  "-c",
  "model_context_window=131072",
  "-c",
  "model_auto_compact_token_limit=1048576",
  "-c",
  "sandbox_mode=\"workspace-write\"",
  "-c",
  "web_search=\"disabled\"",
  "-c",
  "features.apps=false",
  "-c",
  "apps._default.enabled=false",
  "-c",
  "agents.enabled=false",
  "-c",
  "features.remote_plugin=false",
  "-c",
  "features.plugins=false",
  "-c",
  "features.image_generation=false",
  "-c",
  "features.goals=false",
  "-"
 ],
 "session_max_turns": 6,
 "max_calls": 4000
}